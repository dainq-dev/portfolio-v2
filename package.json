{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:css": "tailwindcss -i ./src/input.css -o ./src/index.css --watch",
    "dev:bun": "bun --hot src/index.ts",
    "dev": "bun run dev:css & bun run dev:bun",
    "build:css": "tailwindcss -i ./src/input.css -o ./src/index.css --minify",
    "build": "bun run build:css && bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*' && cp -r public/. dist/",
    "start": "NODE_ENV=production bun src/index.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "gsap": "^3.15.0",
    "gsap-trial": "^3.13.0",
    "react": "^19",
    "react-dom": "^19",
    "react-fast-marquee": "^1.6.5",
    "react-icons": "^5.6.0",
    "three": "^0.184.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@tailwindcss/cli": "^4.3.0",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0"
  }
}
